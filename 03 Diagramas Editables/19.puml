@startuml
autonumber

participant "gestor : GestorSensores" as Gestor
participant "sensor : SensorTemperatura" as Sensor
participant "bitacora : ManejadorArchivos" as Log

Gestor -> Sensor : obtenerLectura()
activate Sensor

Sensor -> Sensor : capturarTemperatura()
Sensor -> Sensor : validarUmbral()

Sensor --x Gestor : LecturaAnomalaException
deactivate Sensor

Gestor -> Log : guardarLog("Lectura fuera de rango")
Log --> Gestor : ok

Gestor -> Gestor : continuarMonitoreo()

@enduml