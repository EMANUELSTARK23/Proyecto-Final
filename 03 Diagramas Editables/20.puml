@startuml
autonumber

participant "gestor : GestorSensores" as Gestor
participant "sensor : ISensorRed" as Sensor
participant "bitacora : ManejadorArchivos" as Log

Gestor -> Sensor : isActivo()
Sensor --> Gestor : false

Gestor -> Log : guardarLog("Sensor inactivo")
Log --> Gestor : ok

Gestor -> Gestor : omitirSensor()
Gestor -> Gestor : continuarConSiguiente()

@enduml