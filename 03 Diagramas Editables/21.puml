@startuml
autonumber

actor Temporizador as Temp
participant "gestor : GestorSensores" as Gestor
participant "bitacora : ManejadorArchivos" as Log

Gestor -> Gestor : verificarFinDeLista()

Gestor -> Log : guardarLog("Ciclo de monitoreo finalizado")
Log --> Gestor : ok

Gestor --> Temp : cicloCompletado()

Temp -> Temp : esperarSiguientePeriodo()

@enduml